{
  "hosting": {
    "site": "lookpyrenees",
    "public": "site",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "scene-api", "region": "europe-west1" }
      }
    ]
  }
}
